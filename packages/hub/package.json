    "@aen/workbench": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
