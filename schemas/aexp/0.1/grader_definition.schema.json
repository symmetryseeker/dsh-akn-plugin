{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aen.dev/schemas/aexp/0.1/grader-definition.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "objectType",
    "graderId",
    "revision",
    "digest",
    "type",
    "target"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "objectType": {
      "const": "grader_definition",
      "type": "string"
    },
    "graderId": {
      "minLength": 1,
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest over RFC 8785 canonical JSON"
    },
    "type": {
      "anyOf": [
        {
          "const": "code",
          "type": "string"
        },
        {
          "const": "model",
          "type": "string"
        },
        {
          "const": "human",
          "type": "string"
        },
        {
          "const": "hybrid",
          "type": "string"
        }
      ]
    },
    "target": {
      "anyOf": [
        {
          "const": "outcome",
          "type": "string"
        },
        {
          "const": "transcript",
          "type": "string"
        },
        {
          "const": "safety",
          "type": "string"
        },
        {
          "const": "efficiency",
          "type": "string"
        }
      ]
    },
    "rubricRef": {
      "type": "object",
      "required": [
        "objectType",
        "refId",
        "digest"
      ],
      "properties": {
        "objectType": {
          "minLength": 1,
          "type": "string"
        },
        "refId": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        },
        "origin": {
          "format": "uri",
          "type": "string"
        }
      }
    },
    "implementationRef": {
      "type": "object",
      "required": [
        "objectType",
        "refId",
        "digest"
      ],
      "properties": {
        "objectType": {
          "minLength": 1,
          "type": "string"
        },
        "refId": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        },
        "origin": {
          "format": "uri",
          "type": "string"
        }
      }
    },
    "modelFingerprint": {
      "type": "object",
      "required": [
        "provider",
        "modelId",
        "observedAt",
        "mutability"
      ],
      "properties": {
        "provider": {
          "minLength": 1,
          "type": "string"
        },
        "modelId": {
          "minLength": 1,
          "type": "string"
        },
        "declaredVersion": {
          "type": "string"
        },
        "providerRevision": {
          "type": "string"
        },
        "immutableWeightsDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        },
        "capabilityDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        },
        "contextWindow": {
          "minimum": 1,
          "type": "integer"
        },
        "requestConfig": {
          "type": "object",
          "required": [
            "configDigest"
          ],
          "properties": {
            "reasoningEffort": {
              "type": "string"
            },
            "temperature": {
              "type": "number"
            },
            "maxOutputTokens": {
              "minimum": 1,
              "type": "integer"
            },
            "seed": {
              "type": "integer"
            },
            "configDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest over RFC 8785 canonical JSON"
            }
          }
        },
        "pricingSnapshotRef": {
          "type": "object",
          "required": [
            "objectType",
            "refId",
            "digest"
          ],
          "properties": {
            "objectType": {
              "minLength": 1,
              "type": "string"
            },
            "refId": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest over RFC 8785 canonical JSON"
            },
            "origin": {
              "format": "uri",
              "type": "string"
            }
          }
        },
        "rateLimitSnapshotRef": {
          "type": "object",
          "required": [
            "objectType",
            "refId",
            "digest"
          ],
          "properties": {
            "objectType": {
              "minLength": 1,
              "type": "string"
            },
            "refId": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest over RFC 8785 canonical JSON"
            },
            "origin": {
              "format": "uri",
              "type": "string"
            }
          }
        },
        "observedAt": {
          "format": "date-time",
          "type": "string"
        },
        "mutability": {
          "anyOf": [
            {
              "const": "immutable",
              "type": "string"
            },
            {
              "const": "versioned",
              "type": "string"
            },
            {
              "const": "provider_mutable",
              "type": "string"
            },
            {
              "const": "unknown",
              "type": "string"
            }
          ]
        }
      }
    },
    "calibrationSetRef": {
      "type": "object",
      "required": [
        "objectType",
        "refId",
        "digest"
      ],
      "properties": {
        "objectType": {
          "minLength": 1,
          "type": "string"
        },
        "refId": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        },
        "origin": {
          "format": "uri",
          "type": "string"
        }
      }
    },
    "calibrationMetrics": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "type": "number"
        }
      }
    },
    "requiredCapabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "description": "Any value representable by RFC 8259 JSON"
        }
      }
    }
  }
}
