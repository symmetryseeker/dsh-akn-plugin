{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aen.dev/schemas/aexp/0.1/evaluation-trial.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "objectType",
    "trialId",
    "digest",
    "experimentId",
    "benchmarkRef",
    "cellId",
    "runObservationRef",
    "attemptIndex",
    "trialIndex",
    "status",
    "graderResults"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "objectType": {
      "const": "evaluation_trial",
      "type": "string"
    },
    "trialId": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest over RFC 8785 canonical JSON"
    },
    "experimentId": {
      "minLength": 1,
      "type": "string"
    },
    "benchmarkRef": {
      "type": "object",
      "required": [
        "objectType",
        "refId",
        "digest"
      ],
      "properties": {
        "objectType": {
          "minLength": 1,
          "type": "string"
        },
        "refId": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        },
        "origin": {
          "format": "uri",
          "type": "string"
        }
      }
    },
    "cellId": {
      "minLength": 1,
      "type": "string"
    },
    "runObservationRef": {
      "type": "object",
      "required": [
        "objectType",
        "refId",
        "digest"
      ],
      "properties": {
        "objectType": {
          "minLength": 1,
          "type": "string"
        },
        "refId": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        },
        "origin": {
          "format": "uri",
          "type": "string"
        }
      }
    },
    "transcriptRef": {
      "type": "object",
      "allOf": [
        {
          "type": "object",
          "required": [
            "objectType",
            "refId",
            "digest"
          ],
          "properties": {
            "objectType": {
              "minLength": 1,
              "type": "string"
            },
            "refId": {
              "minLength": 1,
              "type": "string"
            },
            "revision": {
              "minimum": 1,
              "type": "integer"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$",
              "description": "SHA-256 digest over RFC 8785 canonical JSON"
            },
            "origin": {
              "format": "uri",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "objectType"
          ],
          "properties": {
            "objectType": {
              "anyOf": [
                {
                  "const": "trace_evidence",
                  "type": "string"
                },
                {
                  "const": "observation",
                  "type": "string"
                },
                {
                  "const": "attestation",
                  "type": "string"
                },
                {
                  "const": "contention",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    "attemptIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "trialIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "anyOf": [
        {
          "const": "success",
          "type": "string"
        },
        {
          "const": "agent_failure",
          "type": "string"
        },
        {
          "const": "policy_refusal",
          "type": "string"
        },
        {
          "const": "infra_error",
          "type": "string"
        },
        {
          "const": "grader_error",
          "type": "string"
        },
        {
          "const": "aborted",
          "type": "string"
        }
      ]
    },
    "graderResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterionId",
          "passed",
          "evidenceRefs"
        ],
        "properties": {
          "criterionId": {
            "minLength": 1,
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "score": {
            "type": "number"
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "allOf": [
                {
                  "type": "object",
                  "required": [
                    "objectType",
                    "refId",
                    "digest"
                  ],
                  "properties": {
                    "objectType": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "refId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "revision": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "description": "SHA-256 digest over RFC 8785 canonical JSON"
                    },
                    "origin": {
                      "format": "uri",
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "objectType"
                  ],
                  "properties": {
                    "objectType": {
                      "anyOf": [
                        {
                          "const": "trace_evidence",
                          "type": "string"
                        },
                        {
                          "const": "observation",
                          "type": "string"
                        },
                        {
                          "const": "attestation",
                          "type": "string"
                        },
                        {
                          "const": "contention",
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "requiredCapabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "description": "Any value representable by RFC 8259 JSON"
        }
      }
    }
  }
}
