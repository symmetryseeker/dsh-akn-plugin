{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aen.dev/schemas/aexp/0.1/feedback.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "objectType",
    "feedbackId",
    "digest",
    "experienceRef",
    "decision",
    "sharingScope",
    "createdAt"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "objectType": {
      "const": "feedback",
      "type": "string"
    },
    "feedbackId": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest over RFC 8785 canonical JSON"
    },
    "experienceRef": {
      "type": "object",
      "required": [
        "experienceId",
        "revision",
        "digest"
      ],
      "properties": {
        "experienceId": {
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "SHA-256 digest over RFC 8785 canonical JSON"
        }
      }
    },
    "sessionDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest over RFC 8785 canonical JSON"
    },
    "decision": {
      "anyOf": [
        {
          "const": "viewed",
          "type": "string"
        },
        {
          "const": "adopted",
          "type": "string"
        },
        {
          "const": "rejected",
          "type": "string"
        },
        {
          "const": "rolled_back",
          "type": "string"
        }
      ]
    },
    "outcome": {
      "anyOf": [
        {
          "const": "helpful",
          "type": "string"
        },
        {
          "const": "neutral",
          "type": "string"
        },
        {
          "const": "harmful",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observationId": {
      "type": "string"
    },
    "sharingScope": {
      "anyOf": [
        {
          "const": "local",
          "type": "string"
        },
        {
          "const": "team",
          "type": "string"
        },
        {
          "const": "public_aggregate",
          "type": "string"
        }
      ]
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "requiredCapabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "description": "Any value representable by RFC 8259 JSON"
        }
      }
    }
  }
}
