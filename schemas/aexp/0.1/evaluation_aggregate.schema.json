{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aen.dev/schemas/aexp/0.1/evaluation-aggregate.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "objectType",
    "aggregateId",
    "digest",
    "experimentId",
    "benchmarkRefs",
    "trialRefs",
    "totalTrials",
    "validTrials",
    "metricSummary",
    "statusCounts",
    "excludedTrialCounts",
    "cellSummaries",
    "comparisons"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "objectType": {
      "const": "evaluation_aggregate",
      "type": "string"
    },
    "aggregateId": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest over RFC 8785 canonical JSON"
    },
    "experimentId": {
      "minLength": 1,
      "type": "string"
    },
    "benchmarkRefs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objectType",
          "refId",
          "digest"
        ],
        "properties": {
          "objectType": {
            "minLength": 1,
            "type": "string"
          },
          "refId": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 digest over RFC 8785 canonical JSON"
          },
          "origin": {
            "format": "uri",
            "type": "string"
          }
        }
      }
    },
    "trialRefs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objectType",
          "refId",
          "digest"
        ],
        "properties": {
          "objectType": {
            "minLength": 1,
            "type": "string"
          },
          "refId": {
            "minLength": 1,
            "type": "string"
          },
          "revision": {
            "minimum": 1,
            "type": "integer"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 digest over RFC 8785 canonical JSON"
          },
          "origin": {
            "format": "uri",
            "type": "string"
          }
        }
      }
    },
    "totalTrials": {
      "minimum": 0,
      "type": "integer"
    },
    "validTrials": {
      "minimum": 0,
      "type": "integer"
    },
    "passAt1": {
      "minimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "passAtK": {
      "type": "object",
      "required": [
        "k",
        "estimate"
      ],
      "properties": {
        "k": {
          "minimum": 1,
          "type": "integer"
        },
        "estimate": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        }
      }
    },
    "passPowerK": {
      "type": "object",
      "required": [
        "k",
        "estimate"
      ],
      "properties": {
        "k": {
          "minimum": 1,
          "type": "integer"
        },
        "estimate": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        }
      }
    },
    "perTrialSuccessRate": {
      "type": "object",
      "required": [
        "estimate",
        "method"
      ],
      "properties": {
        "estimate": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "lower": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "upper": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "metricSummary": {
      "type": "object",
      "required": [
        "sampleSize",
        "method"
      ],
      "properties": {
        "sampleSize": {
          "minimum": 0,
          "type": "integer"
        },
        "successRate": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "quality": {
          "type": "object",
          "required": [
            "mean"
          ],
          "properties": {
            "mean": {
              "type": "number"
            },
            "lower": {
              "type": "number"
            },
            "upper": {
              "type": "number"
            }
          }
        },
        "costUsd": {
          "type": "object",
          "required": [
            "mean"
          ],
          "properties": {
            "mean": {
              "minimum": 0,
              "type": "number"
            },
            "lower": {
              "minimum": 0,
              "type": "number"
            },
            "upper": {
              "minimum": 0,
              "type": "number"
            }
          }
        },
        "latencyMs": {
          "type": "object",
          "properties": {
            "p50": {
              "minimum": 0,
              "type": "number"
            },
            "p95": {
              "minimum": 0,
              "type": "number"
            }
          }
        },
        "negativeTransferRate": {
          "minimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "method": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "statusCounts": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "excludedTrialCounts": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "minimum": 0,
          "type": "integer"
        }
      }
    },
    "cellSummaries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "cellId",
          "treatment",
          "trialRefs",
          "totalTrials",
          "validTrials",
          "successes",
          "metricSummary",
          "statusCounts",
          "excludedTrialCounts"
        ],
        "properties": {
          "cellId": {
            "minLength": 1,
            "type": "string"
          },
          "treatment": {
            "anyOf": [
              {
                "const": "baseline",
                "type": "string"
              },
              {
                "const": "experience_applied",
                "type": "string"
              },
              {
                "const": "alternative",
                "type": "string"
              }
            ]
          },
          "trialRefs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "objectType",
                "refId",
                "digest"
              ],
              "properties": {
                "objectType": {
                  "minLength": 1,
                  "type": "string"
                },
                "refId": {
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "SHA-256 digest over RFC 8785 canonical JSON"
                },
                "origin": {
                  "format": "uri",
                  "type": "string"
                }
              }
            }
          },
          "totalTrials": {
            "minimum": 0,
            "type": "integer"
          },
          "validTrials": {
            "minimum": 0,
            "type": "integer"
          },
          "successes": {
            "minimum": 0,
            "type": "integer"
          },
          "passAt1": {
            "minimum": 0,
            "maximum": 1,
            "type": "number"
          },
          "passAtK": {
            "type": "object",
            "required": [
              "k",
              "estimate"
            ],
            "properties": {
              "k": {
                "minimum": 1,
                "type": "integer"
              },
              "estimate": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          },
          "passPowerK": {
            "type": "object",
            "required": [
              "k",
              "estimate"
            ],
            "properties": {
              "k": {
                "minimum": 1,
                "type": "integer"
              },
              "estimate": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              }
            }
          },
          "perTrialSuccessRate": {
            "type": "object",
            "required": [
              "estimate",
              "method"
            ],
            "properties": {
              "estimate": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "lower": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "upper": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "method": {
                "minLength": 1,
                "type": "string"
              }
            }
          },
          "metricSummary": {
            "type": "object",
            "required": [
              "sampleSize",
              "method"
            ],
            "properties": {
              "sampleSize": {
                "minimum": 0,
                "type": "integer"
              },
              "successRate": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "quality": {
                "type": "object",
                "required": [
                  "mean"
                ],
                "properties": {
                  "mean": {
                    "type": "number"
                  },
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  }
                }
              },
              "costUsd": {
                "type": "object",
                "required": [
                  "mean"
                ],
                "properties": {
                  "mean": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "lower": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "upper": {
                    "minimum": 0,
                    "type": "number"
                  }
                }
              },
              "latencyMs": {
                "type": "object",
                "properties": {
                  "p50": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "p95": {
                    "minimum": 0,
                    "type": "number"
                  }
                }
              },
              "negativeTransferRate": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "method": {
                "minLength": 1,
                "type": "string"
              }
            }
          },
          "statusCounts": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "minimum": 0,
                "type": "integer"
              }
            }
          },
          "excludedTrialCounts": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "minimum": 0,
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "comparisonId",
          "comparisonKind",
          "baselineCellId",
          "treatmentCellId",
          "primaryMetric",
          "baselineEstimate",
          "treatmentEstimate",
          "absoluteDifference",
          "uncertainty",
          "conclusion",
          "counterfactualEligibility",
          "confounders"
        ],
        "properties": {
          "comparisonId": {
            "minLength": 1,
            "type": "string"
          },
          "comparisonKind": {
            "anyOf": [
              {
                "const": "experience_uplift",
                "type": "string"
              },
              {
                "const": "model_effect",
                "type": "string"
              },
              {
                "const": "harness_effect",
                "type": "string"
              },
              {
                "const": "model_harness_interaction",
                "type": "string"
              },
              {
                "const": "alternative",
                "type": "string"
              }
            ]
          },
          "baselineCellId": {
            "minLength": 1,
            "type": "string"
          },
          "treatmentCellId": {
            "minLength": 1,
            "type": "string"
          },
          "primaryMetric": {
            "minLength": 1,
            "type": "string"
          },
          "baselineEstimate": {
            "type": "number"
          },
          "treatmentEstimate": {
            "type": "number"
          },
          "absoluteDifference": {
            "type": "number"
          },
          "relativeDifference": {
            "type": "number"
          },
          "uncertainty": {
            "type": "object",
            "required": [
              "method",
              "confidenceLevel"
            ],
            "properties": {
              "method": {
                "minLength": 1,
                "type": "string"
              },
              "confidenceLevel": {
                "minimum": 0,
                "maximum": 1,
                "type": "number"
              },
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              }
            }
          },
          "conclusion": {
            "anyOf": [
              {
                "const": "improved",
                "type": "string"
              },
              {
                "const": "harmed",
                "type": "string"
              },
              {
                "const": "no_significant_difference",
                "type": "string"
              },
              {
                "const": "inconclusive",
                "type": "string"
              }
            ]
          },
          "counterfactualEligibility": {
            "type": "object",
            "required": [
              "status",
              "reasonCodes"
            ],
            "properties": {
              "status": {
                "anyOf": [
                  {
                    "const": "eligible",
                    "type": "string"
                  },
                  {
                    "const": "ineligible",
                    "type": "string"
                  }
                ]
              },
              "reasonCodes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "confounders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requiredCapabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "description": "Any value representable by RFC 8259 JSON"
        }
      }
    }
  }
}
