{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aen.dev/schemas/aexp/0.1/contention.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "objectType",
    "contentionId",
    "digest",
    "claimRef",
    "supporting",
    "contradicting",
    "openedAt"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "objectType": {
      "const": "contention",
      "type": "string"
    },
    "contentionId": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest over RFC 8785 canonical JSON"
    },
    "claimRef": {
      "type": "object",
      "required": [
        "experienceRef",
        "claimId"
      ],
      "properties": {
        "experienceRef": {
          "type": "object",
          "allOf": [
            {
              "type": "object",
              "required": [
                "objectType",
                "refId",
                "digest"
              ],
              "properties": {
                "objectType": {
                  "minLength": 1,
                  "type": "string"
                },
                "refId": {
                  "minLength": 1,
                  "type": "string"
                },
                "revision": {
                  "minimum": 1,
                  "type": "integer"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "SHA-256 digest over RFC 8785 canonical JSON"
                },
                "origin": {
                  "format": "uri",
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "objectType"
              ],
              "properties": {
                "objectType": {
                  "const": "experience_revision",
                  "type": "string"
                }
              }
            }
          ]
        },
        "claimId": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "supporting": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "type": "object",
            "required": [
              "objectType",
              "refId",
              "digest"
            ],
            "properties": {
              "objectType": {
                "minLength": 1,
                "type": "string"
              },
              "refId": {
                "minLength": 1,
                "type": "string"
              },
              "revision": {
                "minimum": 1,
                "type": "integer"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "SHA-256 digest over RFC 8785 canonical JSON"
              },
              "origin": {
                "format": "uri",
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "objectType"
            ],
            "properties": {
              "objectType": {
                "anyOf": [
                  {
                    "const": "trace_evidence",
                    "type": "string"
                  },
                  {
                    "const": "observation",
                    "type": "string"
                  },
                  {
                    "const": "attestation",
                    "type": "string"
                  },
                  {
                    "const": "contention",
                    "type": "string"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "contradicting": {
      "type": "array",
      "items": {
        "type": "object",
        "allOf": [
          {
            "type": "object",
            "required": [
              "objectType",
              "refId",
              "digest"
            ],
            "properties": {
              "objectType": {
                "minLength": 1,
                "type": "string"
              },
              "refId": {
                "minLength": 1,
                "type": "string"
              },
              "revision": {
                "minimum": 1,
                "type": "integer"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$",
                "description": "SHA-256 digest over RFC 8785 canonical JSON"
              },
              "origin": {
                "format": "uri",
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "objectType"
            ],
            "properties": {
              "objectType": {
                "anyOf": [
                  {
                    "const": "trace_evidence",
                    "type": "string"
                  },
                  {
                    "const": "observation",
                    "type": "string"
                  },
                  {
                    "const": "attestation",
                    "type": "string"
                  },
                  {
                    "const": "contention",
                    "type": "string"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "scopeDifference": {
      "type": "string"
    },
    "openedAt": {
      "format": "date-time",
      "type": "string"
    },
    "resolvedAt": {
      "format": "date-time",
      "type": "string"
    },
    "resolution": {
      "anyOf": [
        {
          "const": "claim_narrowed",
          "type": "string"
        },
        {
          "const": "superseded",
          "type": "string"
        },
        {
          "const": "evidence_rejected",
          "type": "string"
        },
        {
          "const": "unresolved",
          "type": "string"
        }
      ]
    },
    "attestations": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://aen.dev/schemas/aexp/0.1/attestation.schema.json",
        "type": "object",
        "required": [
          "protocolVersion",
          "objectType",
          "attestationId",
          "digest",
          "statementDigest",
          "envelope",
          "issuer",
          "issuedAt"
        ],
        "properties": {
          "protocolVersion": {
            "const": "0.1",
            "type": "string"
          },
          "objectType": {
            "const": "attestation",
            "type": "string"
          },
          "attestationId": {
            "minLength": 1,
            "type": "string"
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 digest over RFC 8785 canonical JSON"
          },
          "statementDigest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$",
            "description": "SHA-256 digest over RFC 8785 canonical JSON"
          },
          "envelope": {
            "type": "object",
            "required": [
              "payloadType",
              "payload",
              "signatures"
            ],
            "properties": {
              "payloadType": {
                "const": "application/vnd.in-toto+json",
                "type": "string"
              },
              "payload": {
                "contentEncoding": "base64",
                "type": "string"
              },
              "signatures": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "keyid",
                    "sig"
                  ],
                  "properties": {
                    "keyid": {
                      "format": "uri",
                      "type": "string"
                    },
                    "sig": {
                      "contentEncoding": "base64",
                      "type": "string"
                    },
                    "algorithm": {
                      "anyOf": [
                        {
                          "const": "Ed25519",
                          "type": "string"
                        },
                        {
                          "const": "ES256",
                          "type": "string"
                        },
                        {
                          "const": "RS256",
                          "type": "string"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "issuer": {
            "type": "object",
            "required": [
              "actorId",
              "type"
            ],
            "properties": {
              "actorId": {
                "format": "uri",
                "type": "string"
              },
              "type": {
                "anyOf": [
                  {
                    "const": "human",
                    "type": "string"
                  },
                  {
                    "const": "agent",
                    "type": "string"
                  },
                  {
                    "const": "organization",
                    "type": "string"
                  },
                  {
                    "const": "service",
                    "type": "string"
                  },
                  {
                    "const": "node",
                    "type": "string"
                  }
                ]
              },
              "displayName": {
                "type": "string"
              }
            }
          },
          "issuedAt": {
            "format": "date-time",
            "type": "string"
          },
          "expiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "requiredCapabilities": {
            "uniqueItems": true,
            "type": "array",
            "items": {
              "format": "uri",
              "type": "string"
            }
          },
          "extensions": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "description": "Any value representable by RFC 8259 JSON"
              }
            }
          }
        }
      }
    },
    "requiredCapabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "description": "Any value representable by RFC 8259 JSON"
        }
      }
    }
  }
}
