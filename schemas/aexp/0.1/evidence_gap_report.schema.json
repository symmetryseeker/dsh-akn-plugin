{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aen.dev/schemas/aexp/0.1/evidence-gap-report.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "objectType",
    "reportId",
    "digest",
    "episodeId",
    "missing",
    "conflicts",
    "maximumEvidenceLevel",
    "generatedAt"
  ],
  "properties": {
    "protocolVersion": {
      "const": "0.1",
      "type": "string"
    },
    "objectType": {
      "const": "evidence_gap_report",
      "type": "string"
    },
    "reportId": {
      "minLength": 1,
      "type": "string"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 digest over RFC 8785 canonical JSON"
    },
    "episodeId": {
      "minLength": 1,
      "type": "string"
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "reason",
          "consequence"
        ],
        "properties": {
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "const": "not_recorded",
                "type": "string"
              },
              {
                "const": "redacted",
                "type": "string"
              },
              {
                "const": "unavailable",
                "type": "string"
              },
              {
                "const": "unsupported_adapter",
                "type": "string"
              },
              {
                "const": "license_denied",
                "type": "string"
              }
            ]
          },
          "consequence": {
            "minLength": 1,
            "type": "string"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "sources",
          "resolution"
        ],
        "properties": {
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "sourceRef",
                "valueDigest"
              ],
              "properties": {
                "sourceRef": {
                  "type": "object",
                  "required": [
                    "objectType",
                    "refId",
                    "digest"
                  ],
                  "properties": {
                    "objectType": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "refId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "revision": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$",
                      "description": "SHA-256 digest over RFC 8785 canonical JSON"
                    },
                    "origin": {
                      "format": "uri",
                      "type": "string"
                    }
                  }
                },
                "valueDigest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$",
                  "description": "SHA-256 digest over RFC 8785 canonical JSON"
                }
              }
            }
          },
          "resolution": {
            "anyOf": [
              {
                "const": "unresolved",
                "type": "string"
              },
              {
                "const": "prefer_effective_surface",
                "type": "string"
              },
              {
                "const": "prefer_manifest",
                "type": "string"
              },
              {
                "const": "manual",
                "type": "string"
              }
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "maximumEvidenceLevel": {
      "anyOf": [
        {
          "const": "H0",
          "type": "string"
        },
        {
          "const": "H1",
          "type": "string"
        },
        {
          "const": "H2",
          "type": "string"
        },
        {
          "const": "H3",
          "type": "string"
        },
        {
          "const": "H4",
          "type": "string"
        }
      ]
    },
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "requiredCapabilities": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "format": "uri",
        "type": "string"
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {
          "description": "Any value representable by RFC 8259 JSON"
        }
      }
    }
  }
}
